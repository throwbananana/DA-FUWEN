diff --git a/scripts/services/board_travel_controller.gd b/scripts/services/board_travel_controller.gd
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/scripts/services/board_travel_controller.gd
@@ -0,0 +1,113 @@
+class_name BoardTravelController
+extends RefCounted
+
+const ACTION_NONE := "none"
+const ACTION_TRAVEL := "travel"
+const ACTION_BRANCH := "branch"
+const ACTION_ARRIVAL := "arrival"
+
+var state: BoardTravelState
+
+func _init(travel_state: BoardTravelState = null) -> void:
+	state = travel_state if travel_state != null else BoardTravelState.new()
+
+func attach(travel_state: BoardTravelState) -> void:
+	state = travel_state
+
+func start_roll_travel(current_node_id: int, progression_service: BoardProgressionService, blocked_node_ids: Array[int]) -> Dictionary:
+	if state.pending_roll.is_empty() or not state.awaiting_destination:
+		return {"action": ACTION_NONE}
+
+	state.branch_choice_pending = false
+	state.pending_route_history = [current_node_id]
+	state.pending_route_options.clear()
+	state.pending_route_forced_path.clear()
+	state.pending_route_forced_index = -1
+
+	if state.anchor_override_active and state.reachable_paths.size() == 1:
+		var only_target := int(state.reachable_paths.keys()[0])
+		var forced_path: Array[int] = []
+		for path_node_id in state.reachable_paths.get(only_target, []):
+			forced_path.append(int(path_node_id))
+		state.pending_route_forced_path = forced_path
+		state.pending_route_forced_index = 0
+		state.pending_route_steps_remaining = maxi(0, state.pending_route_forced_path.size() - 1)
+	else:
+		state.pending_route_steps_remaining = int(state.pending_roll.get("value", 0))
+
+	state.awaiting_destination = false
+	return continue_roll_travel(current_node_id, progression_service, blocked_node_ids)
+
+func continue_roll_travel(current_node_id: int, progression_service: BoardProgressionService, blocked_node_ids: Array[int]) -> Dictionary:
+	if state.pending_route_steps_remaining <= 0:
+		return _arrival_action(current_node_id)
+
+	if not state.pending_route_forced_path.is_empty():
+		if state.pending_route_forced_index + 1 >= state.pending_route_forced_path.size():
+			return _arrival_action(current_node_id)
+		var next_id := int(state.pending_route_forced_path[state.pending_route_forced_index + 1])
+		state.pending_route_forced_index += 1
+		return _travel_action(next_id)
+
+	var options := progression_service.get_next_route_options(
+		current_node_id,
+		state.pending_route_steps_remaining,
+		state.pending_route_history
+	)
+	options = _filter_blocked_selectable_nodes(options, blocked_node_ids)
+
+	if options.is_empty():
+		state.pending_route_steps_remaining = 0
+		return {
+			"action": ACTION_ARRIVAL,
+			"final_node_id": current_node_id,
+			"log_line": "前方可继续推进的安全方向都被封住了，本次提前在当前节点停下。",
+		}
+
+	if options.size() == 1:
+		return _travel_action(int(options[0]))
+
+	state.pending_route_options = options.duplicate()
+	state.branch_choice_pending = true
+	return {"action": ACTION_BRANCH, "options": options.duplicate()}
+
+func choose_branch(node_id: int) -> Dictionary:
+	if not state.branch_choice_pending:
+		return {"action": ACTION_NONE}
+	if not state.pending_route_options.has(node_id):
+		return {"action": ACTION_NONE}
+	return _travel_action(node_id)
+
+func register_step_finished(node_id: int, progression_service: BoardProgressionService, blocked_node_ids: Array[int]) -> Dictionary:
+	state.board_anim_locked = false
+	if state.pending_route_history.is_empty() or int(state.pending_route_history[state.pending_route_history.size() - 1]) != node_id:
+		state.pending_route_history.append(node_id)
+	if state.pending_route_steps_remaining > 0:
+		state.pending_route_steps_remaining = maxi(0, state.pending_route_steps_remaining - 1)
+	if state.pending_route_steps_remaining > 0:
+		return continue_roll_travel(node_id, progression_service, blocked_node_ids)
+	return _arrival_action(node_id)
+
+func clear_pending_route_state(clear_roll := true) -> void:
+	state.clear_pending_route_state(clear_roll)
+
+func _travel_action(node_id: int) -> Dictionary:
+	state.branch_choice_pending = false
+	state.pending_route_options.clear()
+	return {"action": ACTION_TRAVEL, "target_node_id": node_id}
+
+func _arrival_action(current_node_id: int) -> Dictionary:
+	return {"action": ACTION_ARRIVAL, "final_node_id": current_node_id}
+
+func _filter_blocked_selectable_nodes(candidate_nodes: Array, blocked_node_ids: Array[int]) -> Array[int]:
+	var blocked := {}
+	for blocked_id in blocked_node_ids:
+		blocked[int(blocked_id)] = true
+
+	var filtered: Array[int] = []
+	for node_id in candidate_nodes:
+		var normalized_id := int(node_id)
+		if blocked.has(normalized_id):
+			continue
+		filtered.append(normalized_id)
+	return filtered
