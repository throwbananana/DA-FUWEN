+class_name BoardTravelState
+extends RefCounted
+
+var awaiting_destination := false
+var pending_roll := {}
+var reachable_paths := {}
+var board_anim_locked := false
+var pending_travel_path: Array[int] = []
+var pending_travel_target := -1
+var branch_choice_pending := false
+var pending_route_steps_remaining := 0
+var pending_route_history: Array[int] = []
+var pending_route_options: Array[int] = []
+var pending_route_forced_path: Array[int] = []
+var pending_route_forced_index := -1
+var anchor_override_active := false
+
+func clear_pending_route_state(clear_roll := true) -> void:
+	awaiting_destination = false
+	branch_choice_pending = false
+	pending_route_steps_remaining = 0
+	pending_route_history.clear()
+	pending_route_options.clear()
+	pending_route_forced_path.clear()
+	pending_route_forced_index = -1
+	reachable_paths.clear()
+	board_anim_locked = false
+	pending_travel_path.clear()
+	pending_travel_target = -1
+	anchor_override_active = false
+	if clear_roll:
+		pending_roll.clear()
+
+func build_snapshot() -> Dictionary:
+	return {
+		"awaiting_destination": awaiting_destination,
+		"pending_roll": pending_roll.duplicate(true),
+		"reachable_paths": reachable_paths.duplicate(true),
+		"pending_route_steps_remaining": pending_route_steps_remaining,
+		"pending_route_history": pending_route_history.duplicate(),
+		"pending_route_options": pending_route_options.duplicate(),
+		"pending_route_forced_path": pending_route_forced_path.duplicate(),
+		"pending_route_forced_index": pending_route_forced_index,
+		"anchor_override_active": anchor_override_active,
+	}
+
+func restore_snapshot(snapshot: Dictionary) -> void:
+	awaiting_destination = bool(snapshot.get("awaiting_destination", false))
+	pending_roll = Dictionary(snapshot.get("pending_roll", {})).duplicate(true)
+	reachable_paths = Dictionary(snapshot.get("reachable_paths", {})).duplicate(true)
+	pending_route_steps_remaining = int(snapshot.get("pending_route_steps_remaining", 0))
+	pending_route_history.clear()
+	for node_id in snapshot.get("pending_route_history", []):
+		pending_route_history.append(int(node_id))
+	pending_route_options.clear()
+	for node_id in snapshot.get("pending_route_options", []):
+		pending_route_options.append(int(node_id))
+	pending_route_forced_path.clear()
+	for node_id in snapshot.get("pending_route_forced_path", []):
+		pending_route_forced_path.append(int(node_id))
+	pending_route_forced_index = int(snapshot.get("pending_route_forced_index", -1))
+	anchor_override_active = bool(snapshot.get("anchor_override_active", false))
