diff --git a/scripts/services/board_stop_resolver.gd b/scripts/services/board_stop_resolver.gd
new file mode 100644
--- /dev/null
+++ b/scripts/services/board_stop_resolver.gd
@@ -0,0 +1,35 @@
+class_name BoardStopResolver
+extends RefCounted
+
+func classify_stop(
+		node: Dictionary,
+		current_visit_habitat_id: String,
+		habitat_unlocked: bool,
+		has_pending_map_effect: bool
+	) -> Dictionary:
+	var type_id := String(node.get("type", ""))
+
+	if type_id == "camp":
+		return {"kind": "camp"}
+	if type_id in ["empty", "environment"]:
+		return {"kind": "environment"}
+	if type_id == "bulletin":
+		return {"kind": "bulletin"}
+	if type_id == "minigame":
+		return {"kind": "minigame"}
+	if type_id == "infirmary":
+		return {"kind": "infirmary"}
+	if not current_visit_habitat_id.is_empty() and not habitat_unlocked and type_id != "event":
+		return {"kind": "locked_habitat"}
+	if type_id == "event":
+		return {
+			"kind": "event",
+			"note_visit": not current_visit_habitat_id.is_empty(),
+		}
+	if has_pending_map_effect:
+		return {
+			"kind": "map_effect",
+			"note_visit": not current_visit_habitat_id.is_empty(),
+		}
+	return {
+		"kind": "visit",
+		"note_visit": not current_visit_habitat_id.is_empty(),
+	}
