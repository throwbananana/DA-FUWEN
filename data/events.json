        {
          "type": "talk",
          "npc": "moss_keeper",
          "text": "迟叔把布递给你，示意先擦外圈，不碰里面铺好的垫层。"
        },
        {
          "type": "talk",
          "npc": "lost_apprentice",
          "text": "小禾在旁边小声记着“擦掉的是水汽，不是气味”。"
        }
      ],
      "choices": [
        {
          "id": "wipe_edges",
          "text": "先擦护理室外圈",
          "outcome": "窝内热气没散，幼体也没被惊动。",
          "effects": {
            "trust": {
              "moss_keeper": 1
            },
            "unlock_dialogue": "dlg_moss_keeper_after_wipe"
          }
        },
        {
          "id": "change_cloth",
          "text": "顺手换一块更干的布",
          "outcome": "入口更清爽，小禾也多记下一条照护细节。",
          "effects": {
            "journal_entry": "记录：潮湿天气下护理室入口更换布层的时机"
          }
        }
      ],
      "tags": [
        "晨间",
        "护理",
        "照料"
      ]
    },
