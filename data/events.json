          "winter"
        ]
      },
      "summary": "阿铂偶尔会拿一件看似报废的旧件，当场演示它为什么还值得留。",
      "stages": [
        {
          "type": "talk",
          "npc": "tinker_bo",
          "text": "阿铂把一枚旧齿轮放到掌心里，先不装，只讲它原来为什么会坏。"
        },
        {
          "type": "talk",
          "npc": "smith_ya",
          "text": "哑叔在旁边敲了一下台面，提醒大家别只听响亮的那一面。"
        }
      ],
      "choices": [
        {
          "id": "listen_story",
          "text": "先听旧件来路",
          "outcome": "围观的人散得慢了些，真正想学的人反而留了下来。",
          "effects": {
            "trust": {
              "tinker_bo": 1
            },
            "unlock_dialogue": "dlg_tinker_bo_after_demo"
          }
        },
        {
          "id": "check_teeth",
          "text": "凑近看磨损边",
          "outcome": "你学会了分辨哪些缺口只是旧，哪些才是真的不能用。",
          "effects": {
            "items": {
              "parts": 1
            }
          }
        }
      ],
      "tags": [
        "市集",
        "旧件",
        "演示"
      ]
    },
