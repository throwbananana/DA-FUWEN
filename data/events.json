    {
      "id": "evt_bazaar_night_swap",
      "title": "机修市夜间换件会",
      "category": "market_event",
      "habitat_id": "copper_hammer_bazaar",
      "participants": [
        "tinker_bo",
        "smith_ya",
        "parts_vendor"
      ],
      "trigger": {
        "after_quest": "bazaar_repair_stall",
        "season": "festival"
      },
      "summary": "节庆夜里，铜锤机修市会临时开放夜间换件区，玩家能听到旧配件、翻新件与装饰件的来源故事。",
      "stages": [
        {
          "type": "talk",
          "npc": "tinker_bo",
          "text": "阿铂邀请玩家看看刚翻新的维修前台旁，新摆出来的一批旧配件。"
        },
        {
          "type": "talk",
          "npc": "smith_ya",
          "text": "哑叔会用敲击声示意每种配件适合装在哪类设备上。"
        }
      ],
      "choices": [
        {
          "id": "swap_stories",
          "text": "听摊主讲翻新件来历",
          "outcome": "能解锁更多社区设施与维修来源词条。",
          "effects": {
            "unlock_encyclopedia": "ency_copper_hammer_bazaar",
            "unlock_dialogue": "dlg_tinker_bo_night_swap"
          }
        },
        {
          "id": "trade_parts",
          "text": "直接换一些常用材料",
          "outcome": "得到少量维修与装饰资源。",
          "effects": {
            "items": {
              "parts": 2,
              "rare_decor_part": 1
            }
          }
        }
      ],
      "mode": "ambient_talk",
      "cooldown_days": 5,
      "weight": 2,
      "tags": [
        "market_event"
      ]
    },
    {
      "id": "evt_bazaar_spare_demo",
      "title": "维修摊位的旧件演示",
      "category": "market_event",
      "mode": "ambient_talk",
      "repeatable": true,
      "cooldown_days": 3,
      "weight": 4,
      "habitat_id": "copper_hammer_bazaar",
      "participants": [
        "tinker_bo",
        "smith_ya",
        "parts_vendor"
      ],
      "trigger": {
        "time_in": [
          "day",
          "evening"
        ],
        "season_in": [
          "spring",
          "summer",
          "autumn",
          "winter"
        ]
      },
      "summary": "阿铂偶尔会拿一件看似报废的旧件，在摊前演示它为什么还值得翻新留用。",
      "stages": [
        {
          "type": "talk",
          "npc": "tinker_bo",
          "text": "阿铂把一枚旧齿轮放到掌心里，先不安装，只讲它原来为什么会坏。"
        },
        {
          "type": "talk",
          "npc": "smith_ya",
          "text": "哑叔在旁边敲了一下台面，提醒大家别只听响亮的那一面。"
        }
      ],
      "choices": [
        {
          "id": "listen_story",
          "text": "先听旧件检修记录",
          "outcome": "围观的人散得慢了些，真正想学维修的人反而留了下来。",
          "effects": {
            "trust": {
              "tinker_bo": 1
            },
            "unlock_dialogue": "dlg_tinker_bo_after_demo"
          }
        },
        {
          "id": "check_teeth",
          "text": "凑近看磨损边和编号",
          "outcome": "你学会了分辨哪些缺口只是旧，哪些才是真的不能用。",
          "effects": {
            "items": {
              "parts": 1
            }
          }
        }
      ],
      "tags": [
        "市集",
        "旧件",
        "演示"
      ]
    },
    {
