    {
      "id": "evt_bazaar_night_swap",
      "title": "铜锤集夜换会",
      "category": "market_event",
      "habitat_id": "copper_hammer_bazaar",
      "participants": [
        "tinker_bo",
        "smith_ya",
        "parts_vendor"
      ],
      "trigger": {
        "after_quest": "bazaar_repair_stall",
        "season": "festival"
      },
      "summary": "节庆夜里，铜锤集会临时开启夜换会，玩家可以听到配件与装饰的来路故事。",
      "stages": [
        {
          "type": "talk",
          "npc": "tinker_bo",
          "text": "阿铂邀请玩家看新修好的摊位上摆出的旧零件。"
        },
        {
          "type": "talk",
          "npc": "smith_ya",
          "text": "哑叔会用敲击声示意每件饰件的用途。"
        }
      ],
      "choices": [
        {
          "id": "swap_stories",
          "text": "听摊主讲零件来历",
          "outcome": "能解锁更多世界观词条。",
          "effects": {
            "unlock_encyclopedia": "ency_copper_hammer_bazaar",
            "unlock_dialogue": "dlg_tinker_bo_night_swap"
          }
        },
        {
          "id": "trade_parts",
          "text": "直接换一些实用材料",
          "outcome": "得到少量维修与装饰资源。",
          "effects": {
            "items": {
              "parts": 2,
              "rare_decor_part": 1
            }
          }
        }
      ],
      "mode": "ambient_talk",
      "cooldown_days": 5,
      "weight": 2,
      "tags": [
        "market_event"
      ]
    },
    {
      "id": "evt_bazaar_spare_demo",
      "title": "旧件摊前的小演示",
      "category": "market_event",
      "mode": "ambient_talk",
      "repeatable": true,
      "cooldown_days": 3,
      "weight": 4,
      "habitat_id": "copper_hammer_bazaar",
      "participants": [
        "tinker_bo",
        "smith_ya",
        "parts_vendor"
      ],
      "trigger": {
        "time_in": [
          "day",
          "evening"
        ],
        "season_in": [
          "spring",
