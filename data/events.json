        },
        {
          "type": "talk",
          "npc": "stone_trader",
          "text": "阿砾顺手挑出几块更圆滑的薄石，说这样在互动池边翻身时不容易磕到边。"
        }
      ],
      "choices": [
        {
          "id": "sort_by_temp",
          "text": "按温度把石头重新排开",
          "outcome": "壳幼挑选得更快，观察也更清楚。",
          "effects": {
            "trust": {
              "washer_grandma": 1
            },
            "unlock_dialogue": "dlg_washer_grandma_after_stones"
          }
        },
        {
          "id": "mark_surface",
          "text": "记下每块石头的表面和温度",
          "outcome": "之后更容易区分适合休息还是适合磨壳。",
          "effects": {
            "items": {
              "warm_stone": 1
            }
          }
        }
      ],
      "tags": [
        "暖石",
        "滨河区",
        "护理"
      ]
