diff --git a/scripts/services/fishing_service.gd b/scripts/services/fishing_service.gd
new file mode 100644
index 0000000..6666666
--- /dev/null
+++ b/scripts/services/fishing_service.gd
@@ -0,0 +1,221 @@
+class_name FishingService
+extends RefCounted
+
+const EncounterServiceScript = preload("res://scripts/services/encounter_service.gd")
+
+const SOURCE_BY_ROD_TIER := {
+	1: "observe",
+	2: "waterside_lure",
+	3: "waterside_rare",
+	4: "waterside_rare",
+}
+
+const DEFAULT_PROFILE := {
+	"required_rod_tier": 1,
+	"base_capture": 42,
+	"base_escape": 18,
+	"line_pressure": 16,
+	"observe_bonus": 6,
+	"calm_bonus": 10,
+	"guide_bonus": 12,
+	"material_reward": {"water_drop": 1},
+}
+
+const CAPTURE_PROFILES := {
+	"shell_pup": {
+		"required_rod_tier": 1,
+		"base_capture": 66,
+		"base_escape": 12,
+		"line_pressure": 10,
+		"observe_bonus": 8,
+		"calm_bonus": 12,
+		"guide_bonus": 16,
+		"material_reward": {"reed": 1},
+	},
+	"ripple_slime": {
+		"required_rod_tier": 2,
+		"base_capture": 54,
+		"base_escape": 20,
+		"line_pressure": 16,
+		"observe_bonus": 9,
+		"calm_bonus": 14,
+		"guide_bonus": 11,
+		"material_reward": {"water_drop": 2},
+	},
+	"stream_glider": {
+		"required_rod_tier": 3,
+		"base_capture": 46,
+		"base_escape": 26,
+		"line_pressure": 24,
+		"observe_bonus": 7,
+		"calm_bonus": 9,
+		"guide_bonus": 18,
+		"material_reward": {"warm_stone": 1},
+	},
+}
+
+var rng := RandomNumberGenerator.new()
+var encounter_service = EncounterServiceScript.new()
+
+func _init() -> void:
+	rng.randomize()
+
+func start_session(habitat_id: String, source: String = "") -> Dictionary:
+	var habitat := DataRepository.get_habitat(habitat_id)
+	if habitat.is_empty():
+		return {"ok": false, "reason": "habitat_missing", "habitat_id": habitat_id}
+	if not Array(habitat.get("visit_actions", [])).has("fish"):
+		return {"ok": false, "reason": "fishing_unavailable", "habitat_id": habitat_id, "message": "这里当前没有可用钓点。"}
+	var rod: Dictionary = GameState.get_equipped_rod()
+	if rod.is_empty():
+		return {"ok": false, "reason": "rod_required", "habitat_id": habitat_id, "message": "你现在没有可用的鱼竿。"}
+	var rod_tier := int(rod.get("rod_tier", 1))
+	var actual_source := source if not source.is_empty() else String(SOURCE_BY_ROD_TIER.get(rod_tier, "observe"))
+	var encounter: Dictionary = encounter_service.roll_encounter(habitat_id, actual_source)
+	if not bool(encounter.get("ok", false)):
+		return encounter
+	var species_id := String(encounter.get("species_id", ""))
+	var profile := _profile_for_species(species_id)
+	return {
+		"ok": true,
+		"mode": "fishing",
+		"habitat_id": habitat_id,
+		"source": actual_source,
+		"species_id": species_id,
+		"species": Dictionary(encounter.get("species", {})).duplicate(true),
+		"mood_id": String(encounter.get("mood_id", "curious")),
+		"rod_id": String(rod.get("id", "")),
+		"rod": rod.duplicate(true),
+		"rod_tier": rod_tier,
+		"required_rod_tier": int(profile.get("required_rod_tier", 1)),
+		"turn_cost": 1,
+		"stay_on_node": true,
+		"available_actions": ["observe", "calm", "guide", "retreat"],
+		"capture_profile": profile.duplicate(true),
+		"message": _session_message(habitat, encounter, rod, profile),
+	}
+
+func resolve_action(encounter: Dictionary, action_id: String) -> Dictionary:
+	if String(encounter.get("mode", "")) != "fishing":
+		return {"ok": false, "reason": "not_fishing"}
+	var species_id := String(encounter.get("species_id", ""))
+	var species: Dictionary = Dictionary(encounter.get("species", {})).duplicate(true)
+	var species_name := String(species.get("name", species_id))
+	var profile: Dictionary = Dictionary(encounter.get("capture_profile", _profile_for_species(species_id))).duplicate(true)
+	var rod: Dictionary = Dictionary(encounter.get("rod", {})).duplicate(true)
+	var rod_id := String(encounter.get("rod_id", ""))
+	var rod_tier := int(encounter.get("rod_tier", 1))
+	var required_tier := int(profile.get("required_rod_tier", 1))
+	if action_id == "retreat":
+		var release_relation := GameState.apply_social_relation_delta("player", "species:%s" % species_id, {"affinity": 1, "fear": -1})
+		var release_journal := "你收回鱼线，把 %s 放回了水面。" % species_name
+		GameState.add_journal_entry(release_journal)
+		return {
+			"ok": true,
+			"mode": "fishing",
+			"outcome": "release_success",
+			"capture": false,
+			"species_id": species_id,
+			"species": species,
+			"rod_id": rod_id,
+			"relation": release_relation,
+			"journal": release_journal,
+			"bond_delta": 0,
+		}
+
+	var capture_score := int(profile.get("base_capture", 42))
+	var escape_score := int(profile.get("base_escape", 18))
+	var line_score := int(profile.get("line_pressure", 16))
+	capture_score += int(rod.get("catch_bonus", 0)) + int(rod.get("hook_power", 0)) * 4
+	escape_score = maxi(0, escape_score - int(rod.get("hook_power", 0)))
+	line_score = maxi(0, line_score - int(rod.get("line_stability", 0)) * 4)
+	match action_id:
+		"observe":
+			capture_score += int(profile.get("observe_bonus", 6))
+			escape_score = maxi(0, escape_score - 4)
+			line_score = maxi(0, line_score - 8)
+		"calm":
+			capture_score += int(profile.get("calm_bonus", 10))
+			escape_score = maxi(0, escape_score - 8)
+			line_score = maxi(0, line_score - 10)
+		"guide":
+			capture_score += int(profile.get("guide_bonus", 12))
+			escape_score += 2
+			line_score += 4
+		_:
+			return {"ok": false, "reason": "unknown_action", "action_id": action_id}
+
+	capture_score += _mood_capture_modifier(String(encounter.get("mood_id", "curious")))
+	if rod_tier < required_tier:
+		var tier_gap := required_tier - rod_tier
+		capture_score -= tier_gap * 18
+		line_score += tier_gap * 12
+		escape_score += tier_gap * 8
+	capture_score = clampi(capture_score, 5, 95)
+	line_score = clampi(line_score, 0, 65)
+	escape_score = clampi(escape_score, 0, 70)
+	var roll := rng.randi_range(1, 100)
+	if roll <= capture_score:
+		return _capture_success(encounter, rod_id)
+	if roll <= capture_score + line_score:
+		return _line_break(encounter, rod_id)
+	if roll <= capture_score + line_score + escape_score:
+		return _escape(encounter, rod_id)
+	return _catch_material(encounter, rod_id)
+
+func _capture_success(encounter: Dictionary, rod_id: String) -> Dictionary:
+	var species_id := String(encounter.get("species_id", ""))
+	var species: Dictionary = Dictionary(encounter.get("species", {})).duplicate(true)
+	var species_name := String(species.get("name", species_id))
+	var captured_uid := GameState.add_companion(species_id)
+	GameState.note_capture(species_id, String(encounter.get("habitat_id", "")), rod_id)
+	var relation := GameState.apply_social_relation_delta("player", "species:%s" % species_id, {"familiarity": 2, "fear": -1})
+	var journal := "你稳住鱼线，把 %s 成功收为同行伙伴。" % species_name
+	GameState.add_journal_entry(journal)
+	return {
+		"ok": true,
+		"mode": "fishing",
+		"outcome": "capture_success",
+		"capture": true,
+		"species_id": species_id,
+		"species": species,
+		"captured_uid": captured_uid,
+		"rod_id": rod_id,
+		"relation": relation,
+		"journal": journal,
+		"bond_delta": 0,
+	}
+
+func _line_break(encounter: Dictionary, rod_id: String) -> Dictionary:
+	var species_id := String(encounter.get("species_id", ""))
+	var species: Dictionary = Dictionary(encounter.get("species", {})).duplicate(true)
+	var species_name := String(species.get("name", species_id))
+	var relation := GameState.apply_social_relation_delta("player", "species:%s" % species_id, {"fear": 1})
+	var journal := "%s 扯断了受力点，鱼线一抖就脱钩了。" % species_name
+	GameState.add_journal_entry(journal)
+	return {"ok": true, "mode": "fishing", "outcome": "capture_fail_line_break", "capture": false, "species_id": species_id, "species": species, "rod_id": rod_id, "relation": relation, "journal": journal, "bond_delta": 0}
+
+func _escape(encounter: Dictionary, rod_id: String) -> Dictionary:
+	var species_id := String(encounter.get("species_id", ""))
+	var species: Dictionary = Dictionary(encounter.get("species", {})).duplicate(true)
+	var species_name := String(species.get("name", species_id))
+	var relation := GameState.apply_social_relation_delta("player", "species:%s" % species_id, {"fear": 1, "familiarity": 1})
+	var journal := "%s 察觉到了你的动作，在最后一刻甩尾逃开。" % species_name
+	GameState.add_journal_entry(journal)
+	return {"ok": true, "mode": "fishing", "outcome": "capture_fail_escape", "capture": false, "species_id": species_id, "species": species, "rod_id": rod_id, "relation": relation, "journal": journal, "bond_delta": 0}
+
+func _catch_material(encounter: Dictionary, rod_id: String) -> Dictionary:
+	var species_id := String(encounter.get("species_id", ""))
+	var species: Dictionary = Dictionary(encounter.get("species", {})).duplicate(true)
+	var species_name := String(species.get("name", species_id))
+	var profile: Dictionary = Dictionary(encounter.get("capture_profile", _profile_for_species(species_id))).duplicate(true)
+	var reward_items: Dictionary = Dictionary(profile.get("material_reward", {"water_drop": 1})).duplicate(true)
+	GameState.grant_items(reward_items)
+	var relation := GameState.apply_social_relation_delta("player", "species:%s" % species_id, {"familiarity": 1})
+	var journal := "你没把 %s 拉上岸，但顺手捞到了 %s。" % [species_name, _format_reward_items(reward_items)]
+	GameState.add_journal_entry(journal)
+	return {"ok": true, "mode": "fishing", "outcome": "catch_material", "capture": false, "species_id": species_id, "species": species, "rod_id": rod_id, "reward_items": reward_items, "relation": relation, "journal": journal, "bond_delta": 0}
+
+func _profile_for_species(species_id: String) -> Dictionary:
+	if CAPTURE_PROFILES.has(species_id):
+		return Dictionary(CAPTURE_PROFILES[species_id]).duplicate(true)
+	return Dictionary(DEFAULT_PROFILE).duplicate(true)
+
+func _mood_capture_modifier(mood_id: String) -> int:
+	match mood_id:
+		"curious", "hungry":
+			return 8
+		"calm", "steady", "placid", "gentle":
+			return 4
+		"alert", "wild", "guarded", "shy":
+			return -6
+		_:
+			return 0
+
+func _session_message(habitat: Dictionary, encounter: Dictionary, rod: Dictionary, profile: Dictionary) -> String:
+	var habitat_name := String(habitat.get("name", String(habitat.get("id", "当前水域"))))
+	var species: Dictionary = Dictionary(encounter.get("species", {})).duplicate(true)
+	var species_name := String(species.get("name", String(encounter.get("species_id", "未知目标"))))
+	var rod_name := String(rod.get("name", "当前鱼竿"))
+	var rod_tier := int(rod.get("rod_tier", 1))
+	var required_tier := int(profile.get("required_rod_tier", 1))
+	if rod_tier < required_tier:
+		return "你停留在当前格子的 %s 抛下鱼线，但这股咬劲明显超出了 %s 的承受范围。" % [habitat_name, rod_name]
+	return "你停留在当前格子的 %s 抛下鱼线，浮漂一沉，像是 %s 咬了钩。" % [habitat_name, species_name]
+
+func _format_reward_items(reward_items: Dictionary) -> String:
+	var parts: Array[String] = []
+	for item_id in reward_items.keys():
+		var item := DataRepository.get_item(String(item_id))
+		parts.append("%s x%d" % [String(item.get("name", item_id)), int(reward_items[item_id])])
+	return ", ".join(parts)
