+func get_available_fishing_rods() -> Array[Dictionary]:
+	var rods: Array[Dictionary] = []
+	for item_id in inventory.keys():
+		if int(inventory.get(item_id, 0)) <= 0:
+			continue
+		var item := DataRepository.get_item(String(item_id))
+		if item.is_empty():
+			continue
+		if String(item.get("type", "")) != "tool":
+			continue
+		if not Array(item.get("tags", [])).has("fishing_rod"):
+			continue
+		rods.append(item)
+	rods.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
+		var tier_a := int(a.get("rod_tier", 0))
+		var tier_b := int(b.get("rod_tier", 0))
+		if tier_a == tier_b:
+			return String(a.get("id", "")) < String(b.get("id", ""))
+		return tier_a < tier_b
+	)
+	return rods
+
+func has_fishing_rod() -> bool:
+	return not get_available_fishing_rods().is_empty()
+
+func get_equipped_rod_id() -> String:
+	if not equipped_rod_id.is_empty() and get_item_count(equipped_rod_id) > 0:
+		return equipped_rod_id
+	var rods := get_available_fishing_rods()
+	if rods.is_empty():
+		equipped_rod_id = ""
+		return ""
+	var best_rod: Dictionary = rods[-1]
+	equipped_rod_id = String(best_rod.get("id", ""))
+	return equipped_rod_id
+
+func get_equipped_rod() -> Dictionary:
+	var rod_id := get_equipped_rod_id()
+	if rod_id.is_empty():
+		return {}
+	return DataRepository.get_item(rod_id)
+
+func equip_rod(rod_id: String) -> bool:
+	var rod := DataRepository.get_item(rod_id)
+	if rod.is_empty() or get_item_count(rod_id) <= 0:
+		return false
+	if String(rod.get("type", "")) != "tool" or not Array(rod.get("tags", [])).has("fishing_rod"):
+		return false
+	equipped_rod_id = rod_id
+	return true
+
+func note_capture(species_id: String, habitat_id: String = "", rod_id: String = "") -> void:
+	if species_id.is_empty():
+		return
+	if not captured_species.has(species_id):
+		captured_species.append(species_id)
+	var stats: Dictionary = Dictionary(fishing_records.get(species_id, {})).duplicate(true)
+	stats["captures"] = int(stats.get("captures", 0)) + 1
+	stats["last_habitat_id"] = habitat_id
+	stats["last_rod_id"] = rod_id
+	stats["last_turn"] = global_turn
+	fishing_records[species_id] = stats
+	register_species_seen(species_id)
+
