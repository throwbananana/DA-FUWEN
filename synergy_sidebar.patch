+	var label := Label.new()
+	label.text = _synergy_icon_fallback(entry)
+	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	label.anchors_preset = Control.PRESET_FULL_RECT
+	label.anchor_right = 1.0
+	label.anchor_bottom = 1.0
+	label.add_theme_font_size_override("font_size", 13)
+	holder.add_child(label)
+	return holder
+
+func _synergy_icon_fallback(entry: Dictionary) -> String:
+	var category := String(entry.get("category", ""))
+	var tag_id := String(entry.get("id", ""))
+	match category:
+		"elements":
+			return GameData.get_type_name(tag_id)
+		"biomes":
+			return String(GameData.BIOME_NAMES.get(tag_id, "域")).substr(0, 1)
+		"jobs":
+			return String(GameData.JOB_NAMES.get(tag_id, "职")).substr(0, 1)
+		"traits":
+			return String(entry.get("name", "羁")).substr(0, 1)
+		_:
+			return "羁"
+
+func _synergy_icon_color(entry: Dictionary) -> Color:
+	var category := String(entry.get("category", ""))
+	var tag_id := String(entry.get("id", ""))
+	match category:
+		"elements":
+			return Color(GameData.TYPE_COLORS.get(tag_id, Color(0.25, 0.35, 0.52, 1.0)))
+		"biomes":
+			return Color(0.22, 0.46, 0.32, 1.0)
+		"jobs":
+			return Color(0.28, 0.34, 0.62, 1.0)
+		"traits":
+			return Color(0.62, 0.42, 0.18, 1.0)
+		_:
+			return Color(0.25, 0.35, 0.52, 1.0)
+
+func _build_synergy_tier_chip(threshold: int, current_tier: int) -> Control:
+	var chip := PanelContainer.new()
+	chip.custom_minimum_size = Vector2(28, 20)
+
+	var style := StyleBoxFlat.new()
+	style.corner_radius_top_left = 999
+	style.corner_radius_top_right = 999
+	style.corner_radius_bottom_left = 999
+	style.corner_radius_bottom_right = 999
+
+	var label := Label.new()
+	label.text = str(threshold)
+	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	label.anchors_preset = Control.PRESET_FULL_RECT
+	label.anchor_right = 1.0
+	label.anchor_bottom = 1.0
+	label.add_theme_font_size_override("font_size", 12)
+
+	if threshold < current_tier:
+		style.bg_color = Color(0.28, 0.37, 0.50, 0.95)
+		label.modulate = Color(0.92, 0.95, 1.0, 1.0)
+	elif threshold == current_tier:
+		style.bg_color = Color(0.95, 0.74, 0.30, 1.0)
+		label.modulate = Color(0.16, 0.13, 0.08, 1.0)
+	else:
+		style.bg_color = Color(0.14, 0.18, 0.27, 0.92)
+		label.modulate = Color(0.45, 0.53, 0.62, 1.0)
+
+	chip.add_theme_stylebox_override("panel", style)
+	chip.add_child(label)
+	return chip
+
+func _synergy_threshold_counts(category: String, tag_id: String) -> Array[int]:
+	var result: Array[int] = []
+	for threshold_entry in GameData.get_synergy_thresholds(category, tag_id):
+		if typeof(threshold_entry) == TYPE_DICTIONARY:
+			result.append(int(threshold_entry.get("count", 0)))
+		else:
+			result.append(int(threshold_entry))
+	if result.is_empty():
+		result = [2, 4, 6]
+	return result
