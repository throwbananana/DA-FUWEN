+func _refresh_synergy_sidebar(report: Dictionary) -> void:
+	if _synergy_sidebar_list == null:
+		return
+	for child in _synergy_sidebar_list.get_children():
+		child.queue_free()
+	var active_entries: Array = report.get("active", [])
+	if active_entries.is_empty() or main_menu_panel.visible:
+		if _synergy_sidebar != null:
+			_synergy_sidebar.visible = false
+		return
+	_synergy_sidebar.visible = true
+	for raw_entry in active_entries:
+		var entry: Dictionary = Dictionary(raw_entry).duplicate(true)
+		_synergy_sidebar_list.add_child(_build_synergy_sidebar_item(entry))
+
+func _build_synergy_sidebar_item(entry: Dictionary) -> Control:
+	var card := PanelContainer.new()
+	card.custom_minimum_size = Vector2(0, 58)
+
+	var card_style := StyleBoxFlat.new()
